{
  "name": "expressionlens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:lab",
    "dev:lab": "npm run dev --workspace @expressionlens/lab",
    "dev:web": "npm run dev --workspace @expressionlens/web",
    "build": "npm run assets:verify && npm run typecheck && npm run build:lab && npm run build:web",
    "build:lab": "npm run assets:verify && npm run build --workspace @expressionlens/lab",
    "build:web": "npm run assets:verify && npm run assets:whisper:verify && npm run build --workspace @expressionlens/web",
    "lint": "oxlint",
    "preview": "npm run preview --workspace @expressionlens/lab",
    "postinstall": "node scripts/sync-wasm.mjs",
    "assets:model": "node scripts/fetch-model.mjs",
    "assets:verify": "node scripts/verify-assets.mjs",
    "verify:web": "node scripts/verify-web-build.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "https:setup": "node scripts/setup-https.mjs",
    "format": "prettier --write .",
    "assets:whisper": "node scripts/fetch-whisper.mjs",
    "assets:whisper:verify": "node scripts/verify-whisper.mjs",
    "assets:vocal": "node scripts/vocal-assets.mjs --download",
    "assets:vocal:verify": "node scripts/vocal-assets.mjs",
    "assets:emotion2vec": "node scripts/fetch-emotion2vec.mjs",
    "assets:setup": "npm run assets:model && npm run assets:whisper && npm run assets:vocal && npm run assets:emotion2vec"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "description": "AI-powered expression analysis"
}
